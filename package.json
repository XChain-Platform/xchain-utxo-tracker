{
  "name": "xchain-utxo-tracker",
  "description": "xchain-utxo-tracker tracks Unspent Transaction Objects (UTXOS) and provides APIs to retrieve UTXO data.",
  "version": "1.0.6",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-platform/xchain-utxo-tracker.git"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "binary-search": "^1.3.6",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoin-core": "^4.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "bs58check": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ecpair": "^2.1.0",
    "encoding-down": "^7.1.0",
    "express": "^4.18.3",
    "express-json-rpc-router": "^1.4.0",
    "helmet": "^7.1.0",
    "leveldown": "^6.1.1",
    "levelup": "^5.1.1",
    "mariadb": "^3.2.3",
    "memdown": "^6.1.1",
    "mysql": "^2.18.1",
    "rocksdb": "^5.2.1",
    "tiny-secp256k1": "^2.2.3"
  },
  "scripts": {
    "api": "node --max-old-space-size=4096 ./src/api.js",
    "test": "mocha --timeout 0 --recursive test/unit/**/*.test.js",
    "test:smoke": "mocha --timeout 10000 test/smoke/smoke.test.js",
    "test:integration": "mocha --timeout 0 --recursive test/integration/**/*.test.js",
    "test:e2e": "mocha --timeout 0 --recursive test/e2e/**/*.test.js --exit",
    "test:fuzz": "mocha --timeout 0 --recursive test/fuzz/**/*.fuzz.js",
    "test:fuzz:quick": "FUZZ_RUNS=100 mocha --timeout 0 --recursive test/fuzz/**/*.fuzz.js",
    "test:fuzz:deep": "FUZZ_RUNS=10000 mocha --timeout 0 --recursive test/fuzz/**/*.fuzz.js",
    "test:perf": "mocha --timeout 0 --recursive test/performance/**/*.perf.js --exit",
    "test:perf:quick": "PERF_SCALE=small mocha --timeout 0 --recursive test/performance/**/*.perf.js --exit",
    "test:perf:deep": "PERF_SCALE=large node --max-old-space-size=4096 ./node_modules/.bin/mocha --timeout 0 --recursive test/performance/**/*.perf.js --exit",
    "test:chaos": "mocha --timeout 0 --recursive test/chaos/**/*.chaos.js",
    "test:all": "mocha --timeout 0 --recursive test/**/*.test.js --exit",
    "mutate": "stryker run test/mutation/stryker.config.json",
    "mutate:quick": "stryker run test/mutation/stryker.quick.config.json",
    "mutate:p1": "stryker run test/mutation/stryker.p1.config.json",
    "mutate:p2": "stryker run test/mutation/stryker.p2.config.json",
    "mutate:p3": "stryker run test/mutation/stryker.p3.config.json",
    "mutate:incremental": "stryker run test/mutation/stryker.config.json --incremental",
    "mutate:custom": "node test/mutation/stryker-plugins/run-custom-mutants.js",
    "mutate:custom:p1": "node test/mutation/stryker-plugins/run-custom-mutants.js --spec 'test/unit/**/*.test.js' --spec 'test/integration/**/*.test.js' src/LevelUpDb.js src/XChainUtxoTracker.js src/bufferutils.js"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/mocha-runner": "^8.6.0",
    "autocannon": "^7.15.0",
    "chai": "^4.5.0",
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.3",
    "supertest": "^7.2.2"
  }
}
