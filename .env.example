# xchain-utxo-tracker configuration. Copy to .env and fill in values.
# Indexes all UTXOs from a coin node into LevelDB and serves address/balance
# queries (primarily for xchain-encoder).

# Required: coin and network (e.g. bitcoin-mainnet, bitcoin-regtest,
# litecoin-testnet, dogecoin-mainnet).
NETWORK=bitcoin-regtest

# Required: coin node RPC connection.
NODE_URL=127.0.0.1
NODE_PORT=8332
NODE_USER=rpcuser
NODE_PASSWORD=rpcpass

# Optional: JSON-RPC API port the tracker listens on.
UTXO_TRACKER_API_PORT=3001

# API key protecting admin JSON-RPC methods (bootstrap snapshot/restore, raw
# key scans). Those methods reject requests (401) unless the caller presents
# this key as "Authorization: Bearer <key>", including when it is left unset.
UTXO_TRACKER_API_KEY=your-key-here

# Optional: CORS allowed origin(s), default disabled (no cross-origin access).
# `*` allows any origin; otherwise give one origin, or a comma-separated
# allowlist that is matched per-origin. A list is what browser shells need,
# because each sends a different origin: iOS 'capacitor://localhost', Android
# 'https://localhost', the hosted explorer its own https origin. A stray `*`
# inside a list is not a wildcard, so the grant fails closed.
# CORS_ORIGIN=
# CORS_ORIGIN=capacitor://localhost,https://localhost,https://explorer.xchain.io

# Optional: API rate limit in requests per minute per IP (default 500).
# UTXO_TRACKER_RATE_LIMIT_RPM=500

# Optional: global cap on requests served concurrently, across ALL client IPs
# (default 100). The per-IP limit above is blind to a stampede spread over many
# addresses; over this cap the tracker answers 429 + Retry-After immediately
# rather than queueing more LevelDB scans. GET /status is exempt. 0 disables.
# UTXO_TRACKER_MAX_CONCURRENT_REQUESTS=100

# Optional: private reserve for the GET /status readiness probe (default 16),
# so healthchecks keep answering while the cap above sheds, without the probe
# route itself becoming an uncapped bypass. 0 disables.
# UTXO_TRACKER_MAX_CONCURRENT_PROBES=16

# Optional: enable AuxPoW (merged-mining) block-header parsing, required for
# Dogecoin-family chains. Set to 1/true to enable.
# AUX_POW=

# Optional: coin node RPC timeout in ms (default 30000).
# NODE_RPC_TIMEOUT=30000

# Optional: LevelDB keep-alive interval in ms (default 10000).
# UTXO_DB_KEEPALIVE_INTERVAL=10000

# Optional: bulk-sync tuning for the initial full-chain ingest. Defaults shown.
# Each numeric knob must be an integer (tip-safety >= 0, the rest >= 1); a
# malformed value is refused with a warning and the default stands, rather than
# reaching the too-short-chain pre-flight as NaN.
# BULK_SYNC_WORKERS=6
# BULK_SYNC_CHUNK_SIZE=10000
# BULK_SYNC_BATCH_SIZE=10000
# BULK_SYNC_RAM_BUDGET=4096
# BULK_SYNC_TIP_SAFETY=10
# BULK_SYNC_WORK_DIR=/data/<db-name>/_bulk-sync-work

# Optional: hard ceiling on how many outputs a single-address query will
# materialize (default 500000); OOM protection against mega payout/coinbase
# addresses. Above it, unbounded get_utxos / get_balance queries fail with
# HTTP 413 so callers page via /utxos?limit=&after= instead.
# UTXO_MAX_ADDRESS_OUTPUTS=500000

# Optional: verbose UTXO tracing for debugging (set to 1/true).
# TRACE_UTXO=
