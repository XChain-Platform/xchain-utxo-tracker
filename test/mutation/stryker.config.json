{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "plugins": [
    "@stryker-mutator/mocha-runner"
  ],
  "mochaOptions": {
    "spec": [
      "test/unit/**/*.test.js",
      "test/integration/**/*.test.js"
    ],
    "config": "test/mutation/.mocharc.stryker.yml"
  },
  "mutate": [
    "src/store/level_up_db.js",
    "src/XChainUtxoTracker.js",
    "src/XChainUtxoTracker/sync_loop.js",
    "src/XChainUtxoTracker/sync_loop_node_tip.js",
    "src/XChainUtxoTracker/sync_loop_block_fetch.js",
    "src/XChainUtxoTracker/sync_loop_block_apply.js",
    "src/XChainUtxoTracker/halt_marker.js",
    "src/chain/bufferutils.js",
    "src/api.js",
    "src/chain/blockchain_connector.js",
    "src/chain/blockchain_connector/auxpow_codec.js",
    "src/chain/blockchain_connector/batch_fetch.js",
    "src/chain/blockchain_connector/block_queries.js",
    "src/chain/blockchain_connector/constants.js",
    "src/chain/blockchain_connector/rpc_helpers.js",
    "src/chain/blockchain_connector/transport_and_mempool.js",
    "src/chain/XChainBlockDecoder.js",
    "src/chain/crypto_networks.js",
    "src/common/util.js"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 1.5,
  "coverageAnalysis": "perTest",
  "incremental": false,
  "incrementalFile": "stryker-incremental.json",
  "ignoreStatic": false,
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": null
  }
}
