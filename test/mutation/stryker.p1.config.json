{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "plugins": [
    "@stryker-mutator/mocha-runner"
  ],
  "mochaOptions": {
    "spec": [
      "test/unit/**/*.test.js",
      "test/integration/**/*.test.js"
    ],
    "config": "test/mutation/.mocharc.stryker.yml"
  },
  "mutate": [
    "src/LevelUpDb.js",
    "src/XChainUtxoTracker.js",
    "src/bufferutils.js"
  ],
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-p1.html"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 1.5,
  "coverageAnalysis": "perTest",
  "incremental": false,
  "incrementalFile": "stryker-incremental.json",
  "ignoreStatic": false,
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": null
  }
}
