{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "plugins": [],
  "commandRunner": {
    "command": "node node_modules/mocha/bin/mocha.js --config test/mutation/.mocharc.stryker.yml --reporter dot 'test/unit/**/*.test.js'"
  },
  "mutate": [
    "src/store/level_up_db.js",
    "src/XChainUtxoTracker.js",
    "src/XChainUtxoTracker/sync_loop.js",
    "src/XChainUtxoTracker/sync_loop_node_tip.js",
    "src/XChainUtxoTracker/sync_loop_block_fetch.js",
    "src/XChainUtxoTracker/sync_loop_block_apply.js",
    "src/XChainUtxoTracker/sync_loop_progress.js",
    "src/XChainUtxoTracker/halt_marker.js",
    "src/chain/bufferutils.js"
  ],
  "reporters": ["clear-text", "progress"],
  "concurrency": 4,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": null
  }
}
