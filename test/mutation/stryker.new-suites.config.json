{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "plugins": [],
  "commandRunner": {
    "command": "node node_modules/mocha/bin/mocha.js --config test/mutation/.mocharc.stryker.yml --reporter dot 'test/boundary/**/*.test.js' 'test/security/**/*.test.js' 'test/regression/**/*.test.js'"
  },
  "_comment": "Focused on the exact functions the new boundary/security/regression suites exercise, via Stryker line-range mutate syntax. satoshiToDecimalString + coinFromNetwork/resolveUndoBlocks (XChainUtxoTracker), and rangeEnd + getOutputsScriptPubKey + getValuesFromKeyPattern (LevelUpDb).",
  "mutate": [
    "src/XChainUtxoTracker.js:54-60",
    "src/XChainUtxoTracker.js:88-101",
    "src/store/level_up_db.js:92-101",
    "src/store/level_up_db.js:1106-1132",
    "src/store/level_up_db.js:1223-1247"
  ],
  "reporters": ["clear-text", "progress"],
  "concurrency": 4,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
