{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "plugins": [
    "@stryker-mutator/mocha-runner"
  ],
  "mochaOptions": {
    "spec": [
      "test/unit/**/*.test.js"
    ],
    "config": "test/mutation/.mocharc.stryker.yml"
  },
  "mutate": [
    "src/api.js",
    "src/BlockchainConnector.js",
    "src/XChainBlockDecoder.js"
  ],
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-p2.html"
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  }
}
