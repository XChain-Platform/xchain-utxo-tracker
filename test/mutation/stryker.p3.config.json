{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "plugins": [],
  "commandRunner": {
    "command": "node node_modules/mocha/bin/mocha.js --config test/mutation/.mocharc.stryker.yml --reporter dot 'test/unit/**/*.test.js'"
  },
  "mutate": [
    "src/chain/crypto_networks.js",
    "src/common/util.js",
    "src/common/install_methods.js"
  ],
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation-p3.html"
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": null
  }
}
